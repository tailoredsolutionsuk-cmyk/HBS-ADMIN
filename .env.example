MAKE_WEBHOOK_URL=
SERPAPI_API_KEY=
BRAVE_SEARCH_API_KEY=

# JARVIS assistant: choose openai for direct Responses API access or vercel
# for the existing AI Gateway route. Unset preserves the Vercel route.
JARVIS_AI_PROVIDER=openai
# Server-only OpenAI project key. Never use NEXT_PUBLIC_ or commit the value.
OPENAI_API_KEY=
# Bare OpenAI model ID; confirm this model is available in your OpenAI project.
OPENAI_MODEL=gpt-5.4-mini
OPENAI_PROJECT_ID=

# AI Gateway uses Vercel OIDC automatically in Vercel deployments. A key is
# only needed for local development or an external runtime. Keep it a Secret.
AI_GATEWAY_API_KEY=
# Existing Gateway model. Used when JARVIS_AI_PROVIDER=vercel.
AI_GATEWAY_MODEL=openai/gpt-5.4-mini
# Legacy fallback only; remove after every environment has AI_GATEWAY_MODEL.
AI_MODEL=

# Website builder only. Does not change the CRM assistant model.
BUILDER_AI_MODEL=openai/gpt-5.4-mini
BUILDER_AI_DAILY_BUDGET_USD=3
BUILDER_PUBLIC_ORIGIN=https://www.hbsmarketing.online
PORTAL_PUBLIC_ORIGIN=https://www.hbsmarketing.online
# Separate random secrets, at least 32 characters, server-only. Never NEXT_PUBLIC_.
CRON_SECRET=
BUILDER_FORM_SECRET=
# Shared only with trusted Codex/ChatGPT/Make automation. At least 32 random characters.
HBS_ACTIVITY_WEBHOOK_SECRET=

# Outlook Calendar (server-only). Register the redirect URI as a Web platform
# URI in Microsoft Entra. Never put the client secret or encryption key in NEXT_PUBLIC_.
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=https://www.hbsmarketing.online/api/admin/calendar/callback
# 32 random bytes encoded as 64 hexadecimal characters.
OUTLOOK_TOKEN_ENCRYPTION_KEY=

# Google Sheets outreach sync (server-only). Enable Google Sheets API in Google Cloud
# and register the callback URL as an authorised redirect URI.
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_SHEETS_REDIRECT_URI=https://www.hbsmarketing.online/api/admin/google-sheets/callback
# 32 random bytes encoded as 64 hexadecimal characters.
GOOGLE_SHEETS_TOKEN_ENCRYPTION_KEY=

# Optional dedicated Google Calendar app. By default reuse the Google Sheets
# OAuth client and derive a separate Calendar encryption key from its key.
# Register the Calendar callback on that same Google OAuth web client.
# Set BOTH dedicated client values if using a separate OAuth application.
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=https://www.hbsmarketing.online/api/admin/calendar/google/callback
# GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
# GOOGLE_CALENDAR_ACCOUNT_EMAIL=tailoredsolutionsuk@gmail.com

